# Copy to .env on the server, next to docker-compose.prod.yml, and fill in.
# Generate secrets with: openssl rand -hex 32

# The domain pointing at this server, e.g. yzujudge.com
SITE_ADDRESS=localhost

SECRET_KEY=
POSTGRES_PASSWORD=

# Sign up and password reset codes go out through Resend (resend.com).
# The sending domain must be verified there first.
RESEND_API_KEY=
EMAIL_FROM=YZU Judge <codes@send.yzujudge.com>

# Off-site copy of the daily backup (deploy/backup.sh). Leave these empty to keep
# backups on this server only. For Cloudflare R2: create a bucket and an API token
# with "Object Read & Write" on that bucket only; the endpoint is
# https://<account id>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
