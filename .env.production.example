# Copy to .env on the server, next to docker-compose.prod.yml, and fill in.
# Generate secrets with: openssl rand -hex 32

# The domain pointing at this server, e.g. yzujudge.com
SITE_ADDRESS=localhost

SECRET_KEY=
POSTGRES_PASSWORD=

# Sign up and password reset codes go out through Resend (resend.com).
# The sending domain must be verified there first.
RESEND_API_KEY=
EMAIL_FROM=YZU Judge <codes@send.yzujudge.com>

# Sign up and code email limits. Leave them out to use the defaults, which already
# let a whole class (about 90 students) sign up from one campus address in an hour.
# Resend's free plan sends 100 emails a day; EMAILS_PER_DAY_GLOBAL stays under that.
# On a paid Resend plan, raise these. A bigger lecture hall or lab needs a bigger number.
REGISTER_LIMIT_PER_HOUR=500
LOGIN_LIMIT_PER_IP_PER_MINUTE=120
EMAILS_PER_IP_PER_HOUR=200
EMAILS_PER_DAY_GLOBAL=90

# Off-site copy of the daily backup (deploy/backup.sh). Leave these empty to keep
# backups on this server only. For Cloudflare R2: create a bucket and an API token
# with "Object Read & Write" on that bucket only; the endpoint is
# https://<account id>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
