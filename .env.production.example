# Copy to .env on the server, next to docker-compose.prod.yml, and fill in.
# Generate secrets with: openssl rand -hex 32

# The domain pointing at this server, e.g. yzujudge.com
SITE_ADDRESS=localhost

SECRET_KEY=
POSTGRES_PASSWORD=

# Sign up and password reset codes go out through Resend (resend.com).
# The sending domain must be verified there first.
RESEND_API_KEY=
EMAIL_FROM=YZU Judge <no-reply@send.yzujudge.com>
