# SITE_ADDRESS is the domain, e.g. yzujudge.com. Caddy gets and renews its HTTPS
# certificate on its own. "localhost" gives a self-signed one for a local test.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Caps request bodies before they reach the API. Admins upload test files in
	# bulk, so the test case endpoints get a larger cap than everything else.
	@testcase_upload path_regexp ^/api/problems/\d+/testcases
	@other_requests not path_regexp ^/api/problems/\d+/testcases
	request_body @testcase_upload {
		max_size 64MB
	}
	request_body @other_requests {
		max_size 2MB
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Vite puts a hash of the content in every file name here, so a file never changes
	# and browsers can keep it for a year. A missing one is a 404, not the app page:
	# a tab opened before a deploy asks for the old names and must not cache HTML as JS.
	handle /assets/* {
		root * /srv
		@hashed file
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# Without this, browsers guess how long to keep index.html and keep showing
		# the old site after a deploy until someone reloads. no-cache still lets them
		# store it; they only ask first, and an unchanged page costs a tiny 304.
		header Cache-Control "no-cache"
		# React Router owns the paths, so unknown ones fall back to the app.
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Everything the app loads comes from this origin. CodeMirror injects its
		# styles at runtime, which is why inline styles are allowed.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		-Server
	}
}

# www and the bare IP both lead to the one canonical address.
www.{$SITE_ADDRESS:localhost} {
	redir https://{$SITE_ADDRESS:localhost}{uri} permanent
}

http:// {
	redir https://{$SITE_ADDRESS:localhost}{uri} permanent
}
